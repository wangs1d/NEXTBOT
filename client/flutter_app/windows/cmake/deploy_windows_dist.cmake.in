# Runs at install time (after every `flutter build windows` / IDE build).
# Mirrors the installed runner bundle to windows_dist/<Config>.
# Do not use CMAKE_INSTALL_PREFIX here: Flutter's cmake_install.cmake sets it to
# $<TARGET_FILE_DIR:...>, which is not expanded when cmake runs the install script.

set(NEXTBOT_DEPLOY_ROOT "@NEXTBOT_DEPLOY_ROOT@")
set(NEXTBOT_DEFAULT_CFG "@NEXTBOT_DEFAULT_BUILD_TYPE@")

if(CMAKE_INSTALL_CONFIG_NAME)
  set(_cfg "${CMAKE_INSTALL_CONFIG_NAME}")
elseif(NEXTBOT_DEFAULT_CFG)
  set(_cfg "${NEXTBOT_DEFAULT_CFG}")
else()
  set(_cfg "Release")
endif()

get_filename_component(_src "${CMAKE_CURRENT_LIST_DIR}/runner/${_cfg}" ABSOLUTE)
set(_dest "${NEXTBOT_DEPLOY_ROOT}/${_cfg}")

message(STATUS "Nextbot: mirroring Windows bundle ${_src} -> ${_dest}")

# 捆绑 runtime 存活（2026-11-28）：windows_dist\Release 自 2026-11-27 起是
# 「app + runtime 的完整本地版」，自启链（Run 键 / app-launcher.mjs /
# launch-desktop-app.ps1）三处都指向这个固定路径，LocalRuntimeManager.isBundled
# 也认这里的 runtime\node.exe。runtime 由 build-installer.ps1 的 [3.10] 从
# staging 同步过来——但本文件的 REMOVE_RECURSE 会连 runtime 一起整目录抹掉
# （build_windows.ps1 的 robocopy /XD runtime 挡不住这里：cmake install 在
# flutter build 内部先跑，2026-11-28 实证：installer 出包当晚一次普通
# flutter build 就把 Release\runtime 清没了，本地版被打回 cloud 壳）。
# 处理：抹除前把 runtime 挪到部署根的暂存目录，镜像完成后再放回去。
set(_runtime_keep "${NEXTBOT_DEPLOY_ROOT}/.runtime-keep")
if(EXISTS "${_dest}/runtime")
  if(EXISTS "${_runtime_keep}")
    file(REMOVE_RECURSE "${_runtime_keep}")
  endif()
  file(RENAME "${_dest}/runtime" "${_runtime_keep}")
endif()

if(EXISTS "${_dest}")
  file(REMOVE_RECURSE "${_dest}")
endif()

# copy_directory_if_different：未变的文件跳过写入。其他程序（编辑器索引器）
# 以独占只读句柄持有产物文件时，REMOVE_RECURSE 会静默失败、copy_directory 再
# 撞上同一把锁把整个构建打挂（2026-10-25：ZCode 持有两个字体文件 →
# MSB3073 / Permission denied，编译早已成功）。内容未变的锁定文件跳过即可，
# 内容真变了的文件照样会失败——该失败仍是真问题。
execute_process(
  COMMAND "${CMAKE_COMMAND}" -E copy_directory_if_different "${_src}" "${_dest}"
  RESULT_VARIABLE _nextbot_copy_rc)
if(NOT _nextbot_copy_rc EQUAL 0)
  message(FATAL_ERROR "Nextbot: copy to windows_dist failed (code ${_nextbot_copy_rc})")
endif()

# 镜像完成：把抹除前挪走的捆绑 runtime 放回原位（app 产物里不含 runtime，
# 放回不会与 copy 结果冲突；上轮构建 FATAL 中断留下的暂存也在这里归位）
if(EXISTS "${_runtime_keep}")
  file(RENAME "${_runtime_keep}" "${_dest}/runtime")
endif()
