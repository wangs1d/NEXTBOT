<?xml version="1.0" encoding="utf-8"?>
<!-- 资料库预取文件字节的落盘目录（MediaDiskCache 存在 getApplicationSupportDirectory()/media_cache）。
     FileOpenPlugin 经 FileProvider 把这些文件转成 content:// URI 交系统应用打开。 -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="library_media_cache" path="media_cache/" />
</paths>
