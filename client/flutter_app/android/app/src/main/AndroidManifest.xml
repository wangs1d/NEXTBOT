<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络与桥接 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>

    <!-- 厂商推送（华为 HMS 直连）：HMS SDK manifest 自带权限合并；指纹与
         agconnect-services.json 见 docs/mobile-push-jpush-setup.md -->
    <uses-permission android:name="android.permission.RECEIVE_USER_PRESENT"/>

    <!-- 电量 -->
    <uses-permission android:name="android.permission.BATTERY_STATS"/>

    <!-- 闹钟（docs/mobile-agent-reminder-alarm-design.md §6/§10）：
         SCHEDULE_EXACT_ALARM 精确闹钟（Android 12+ 可撤销，运行时探测降级 setWindow）；
         USE_FULL_SCREEN_INTENT 锁屏满屏响铃页（Android 14+ 需用户设置页确认）；
         WAKE_LOCK/VIBRATE 响铃伴随振动；FOREGROUND_SERVICE_MEDIA_PLAYBACK 支撑响铃前台服务。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <!-- 通知（BIND_NOTIFICATION_LISTENER_SERVICE 是 service 级权限，
         声明在 MessageCaptureListenerService 的 android:permission 上，不能写成 uses-permission） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- 相机 -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <!-- 定位 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!-- 响铃与唤醒 -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

    <!-- 短信 / 通话记录 -->
    <uses-permission android:name="android.permission.READ_SMS"/>
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>

    <!-- 手机桥接拨号（phone.dial）：确认窗确认后直接拨出 -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>

    <!-- 短信代发（messages.reply / send_sms）：确认窗确认后发送 -->
    <uses-permission android:name="android.permission.SEND_SMS"/>

    <!-- 前台服务与电池优化白名单 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:label="Nextbot"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 手机桥接拨号确认窗：Agent 发起 phone.dial 时弹出的全屏半透明窗 -->
        <activity
            android:name=".DialConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/DialConfirmTheme"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|screenLayout"
            android:showWhenLocked="true"
            android:turnScreenOn="true"/>

        <!-- 短信代发确认窗：Agent 发起 send_sms 时展示号码与内容，用户确认后 SmsManager 发出 -->
        <activity
            android:name=".SmsSendConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/DialConfirmTheme"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|screenLayout"
            android:showWhenLocked="true"
            android:turnScreenOn="true"/>

        <!-- 录屏授权中转窗：MediaProjection 系统授权必须由前台 Activity 发起 -->
        <activity
            android:name=".ScreenRecordConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/DialConfirmTheme"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|screenLayout"
            android:showWhenLocked="true"
            android:turnScreenOn="true"/>

        <!-- 通知监听：捕捉微信/QQ/飞书/短信通知 → 批量上报服务端消息聚合中心。
             通知使用权需用户在系统设置里手动授予（设置页有引导跳转）。 -->
        <service
            android:name=".MessageCaptureListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <!-- 消息桥接前台服务：常驻通知保活 WS 桥接与消息上报、定位低频回传 -->
        <service
            android:name=".MessageBridgeForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|location"/>

        <!-- 远程拍照：camera 类型前台服务 + CameraX -->
        <service
            android:name=".CameraCaptureService"
            android:exported="false"
            android:foregroundServiceType="camera"/>

        <!-- 屏幕录制：mediaProjection 类型前台服务 + MediaRecorder -->
        <service
            android:name=".ScreenRecordService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"/>

        <!-- 开机自启：重启前台服务恢复桥接与消息捕捉 + 闹钟精确闹钟重挂 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- 闹钟到点广播：AlarmManager 精确闹钟 → 拉起响铃前台服务 -->
        <receiver
            android:name=".AlarmClockReceiver"
            android:exported="false"/>

        <!-- 闹钟通知动作（贪睡/关闭）：转回 Dart AlarmEngine 或 REST 兜底 -->
        <receiver
            android:name=".AlarmRingActionsReceiver"
            android:exported="false"/>

        <!-- 闹钟响铃前台服务：mediaPlayback 类型（Android 14+ 必须显式声明类型） -->
        <service
            android:name=".AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"/>

        <!-- HMS Push token 事件回调：token 就绪/刷新时系统主动送达（App 后台也生效），
             写入 SharedPreferences 供 MobilePushPlugin 随取随用 -->
        <service
            android:name=".PushTokenService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.huawei.push.action.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
