{
  "name": "private-ai-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server",
    "agent-world",
    "packages/agent-protocol",
    "packages/picture"
  ],
  "scripts": {
    "dev:all": "node scripts/dev-all.mjs",
    "dev:client:watch": "node scripts/dev-client-watch.mjs",
    "dev:desktop": "node scripts/desktop-hot-reload.mjs",
    "dev:desktop:once": "node scripts/desktop-hot-reload.mjs --once",
    "dev:all:server": "npm run dev:server --workspace=server",
    "dev:ports:free": "powershell -ExecutionPolicy Bypass -File scripts/free-dev-ports.ps1",
    "autostart:install": "node scripts/autostart/install-autostart.mjs",
    "autostart:uninstall": "node scripts/autostart/uninstall-autostart.mjs",
    "autostart:status": "node scripts/autostart/status-autostart.mjs",
    "setup:openclaw": "npm install -g openclaw @tencent-weixin/openclaw-weixin",
    "setup:openclaw-wechat-bridge": "node scripts/install-openclaw-wechat-bridge.mjs",
    "dev:remote": "node scripts/dev-all.mjs --remote",
    "dev:all:runtime": "npm run dev:runtime --workspace=server"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0"
  },
  "overrides": {
    "gcp-metadata": "^8.1.2",
    "uuid": "^11.1.1",
    "mem0ai": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.30"
  }
}
