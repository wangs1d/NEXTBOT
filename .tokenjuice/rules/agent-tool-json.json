{
  "id": "nextbot-tool-json",
  "family": "generic-json",
  "description": "Compact large JSON tool results from Nextbot registry tools",
  "priority": 50,
  "match": {
    "toolNames": [
      "fetch_web",
      "search_web",
      "info.search",
      "info.read_webpage",
      "info.inspect_webpage",
      "info.navigate_site",
      "browser.fetch_page",
      "schedule.list",
      "schedule.create",
      "world.list_rooms",
      "aip.query",
      "life.budget"
    ]
  },
  "summarize": {
    "head": 40,
    "tail": 12
  },
  "transforms": {
    "stripAnsi": true,
    "dedupeAdjacent": true,
    "trimEmptyEdges": true
  }
}
