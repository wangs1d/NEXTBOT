# ---------- 区域版本（domestic / intl）----------
# 决定 auto 模式下的 LLM provider 优先级与默认功能开关：
# - domestic（默认）：auto 优先 Kimi，其次 OpenAI；启用微信 Claw / 虚拟电话 / 钱包
# - intl：auto 优先 OpenAI，其次 Kimi；关闭国内专属功能
# 区域文件 `.env.domestic` / `.env.intl` 会在 `.env` 之后、`.env.local` 之前加载，
# 用于覆盖区域相关的非密钥配置。密钥始终放 `.env.local`。
# REGION=domestic

# 外部对话模型：
#   auto — 优先 Kimi（MOONSHOT_API_KEY），其次 MiniMax（MINIMAX_API_KEY），否则 OpenAI（OPENAI_API_KEY）
#          ※ auto 模式下优先级受 REGION 影响（见上）
#   none — 关闭云端模型
#   moonshot-kimi | minimax | openai — 固定单一提供方
#   failover — 按 EXTERNAL_MODEL_FAILOVER_CHAIN 顺序故障切换（需至少一方密钥）
# EXTERNAL_MODEL_PROVIDER=auto

# failover 时的顺序（逗号分隔，id：moonshot-kimi、minimax、openai）
# EXTERNAL_MODEL_FAILOVER_CHAIN=moonshot-kimi,openai

# 意图路由跟随主模型（单模型配置，2026-10-10）：路由调用的输出预算/超时按
# provider 能力档案自适应（src/external-model/provider-profiles.ts：
# 快模型 192 tokens/3s；思考型如 minimax 1024 tokens/5s）。换模型只需在
# 档案表登记一行，路由与旁路调用自动适配。下行可显式覆盖超时（对所有 provider 生效）：
# LLM_ROUTE_TIMEOUT_MS=

# Moonshot Kimi API（与 OpenAI SDK 兼容）
# 密钥请写入同目录 .env.local（已 gitignore），勿写在本文件或提交 Git。
# 在 https://platform.kimi.ai 创建密钥后填入 server/.env.local：
#   MOONSHOT_API_KEY=sk-...
#   MOONSHOT_MODEL=kimi-k2.5
#   EXTERNAL_MODEL_PROVIDER=moonshot-kimi
# MOONSHOT_API_KEY=

# 可选，默认 kimi-k2.5
# MOONSHOT_MODEL=kimi-k2.5

# 可选 Base URL（须与密钥所属控制台一致，否则会 401 Invalid Authentication）
# 国内密钥（默认示例）：https://api.moonshot.cn/v1
# 国际密钥：https://api.moonshot.ai/v1
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# MiniMax API（OpenAI 兼容，M2 系文本模型，思考默认开启无法关闭）
# 密钥请写入同目录 .env.local（已 gitignore），勿写在本文件或提交 Git。
# 在 https://platform.minimaxi.com 创建密钥后填入 server/.env.local：
#   MINIMAX_API_KEY=...
#   EXTERNAL_MODEL_PROVIDER=minimax
# MINIMAX_API_KEY=

# 可选，默认 MiniMax-M3（平台在线模型：M2 / M2.1 / M2.5 / M2.7 及 -highspeed 变体 / M3）
# MINIMAX_MODEL=MiniMax-M3

# 可选 Base URL（须与密钥所属控制台一致，密钥不互通）
# 国内密钥（默认）：https://api.minimaxi.com/v1
# 国际密钥：https://api.minimax.io/v1
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# 可选：高德 Web 服务 Key，GPS 逆地理优先走高德（需在控制台开通「Web 服务」）
# AMAP_WEB_KEY=

# IP 定位已禁用；时钟/位置仅依赖前端 GPS + /geo/reverse 逆地理

# 球形具身自主漫游（默认开启；设 0 关闭服务端自发身体移动）
# ENABLE_EMBODIMENT_AUTONOMY=1

# ---------- 主 Agent 委派子 Agent（支持并行 + 后台委派） ----------
# 1=启用：主 Agent 通过 master_invoke_sub_agent 动态委派子 Agent
# 子 Agent 委派（默认：已配置外部模型 API Key 时自动开启；显式关闭 ENABLE_MASTER_AGENT_DELEGATION=0）
# ENABLE_MASTER_AGENT_DELEGATION=1
# 兼容旧名（仍有效，后续版本可能移除）：ENABLE_MULTI_AGENT_COORDINATION=1
# 主 Agent 在对话中调用 master_invoke_sub_agent（默认开启）；设 0 关闭委派工具
# MASTER_AGENT_DELEGATE_VIA_TOOLS=1
# 恢复旧版「先 JSON 分解再串行调用」：MASTER_AGENT_LEGACY_DECOMPOSE=1
# 子 Agent 单次委派超时（毫秒，默认 60 秒）
# SUBTASK_TIMEOUT_MS=60000
# tech 子 Agent 专用超时（深度 RPA / 代码，默认 120 秒）
# TECH_SUBTASK_TIMEOUT_MS=120000
# info 子 Agent 专用超时（多轮联网检索，默认 90 秒）
# INFO_SUBTASK_TIMEOUT_MS=90000
# 每轮最多委派子 Agent 次数（默认 6）
# MASTER_AGENT_MAX_SUB_AGENT_INVOCATIONS=6
# 同时运行的子 Agent 上限（默认 3；同一 tool 批次内可并行委派）
# MAX_PARALLEL_SUB_AGENTS=3
# 强制主 Agent 额外合成 LLM（默认子 Agent 全成功且较短时跳过）
# MASTER_AGENT_FORCE_SYNTHESIS=1
# 子 Agent 全成功且拼接结果不超过该字数时，跳过额外合成 LLM（默认 2800）
# MASTER_AGENT_DIRECT_REPLY_MAX_CHARS=2800
# 主 Agent 委派详细日志（默认 false）
# MASTER_AGENT_DELEGATION_VERBOSE=false
# 兼容旧名：MULTI_AGENT_VERBOSE=false

# OpenAI 官方 API（与 auto / openai / failover 配合）
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI prefix caching（用于复用固定 system/tools 前缀的 KV cache，默认开启）
# OPENAI_PREFIX_CACHE_ENABLED=1
# 可选命名空间；多套 prompt 模板并存时可手动区分
# OPENAI_PROMPT_CACHE_NAMESPACE=private-ai-agent-system-prompt-v1
# 仅当模型支持时才会下发；当前仅接受 24h
# OPENAI_PROMPT_CACHE_RETENTION=24h

# Moonshot / Kimi 自动 context caching 的前缀分层优化（默认开启）
# MOONSHOT_PREFIX_CACHE_ENABLED=1
# MOONSHOT_PROMPT_CACHE_NAMESPACE=private-ai-agent-system-prompt-v1

# ---------- MiniMax 语音（TTS speech-2.5 + 端到端实时语音 Realtime API，优先于 OpenAI TTS） ----------
# 在 https://platform.minimaxi.com 创建应用获取 API Key
# MINIMAX_API_KEY=sk-api-xxxxxxxxxxxxxxxxxxxxxxxx
# 国内端点（注意双 i）；国际站 key 才用 https://api.minimax.io
# MINIMAX_BASE_URL=https://api.minimaxi.com
# TTS 模型：speech-2.5-turbo-preview（快）/ speech-2.5-hd-preview（画质优先）
# MINIMAX_TTS_MODEL=speech-2.5-turbo-preview
# 系统音色：female-shaonv / female-yujie / presenter_female / male-qn-qingse
# MINIMAX_TTS_VOICE=female-shaonv
# 语速 0.5 ~ 2
# MINIMAX_TTS_SPEED=1
# 端到端实时语音对话（Realtime API，wss://api.minimaxi.com/ws/v1/realtime）
# MINIMAX_REALTIME_VOICE=female-shaonv
# MINIMAX_REALTIME_INSTRUCTIONS=你是用户的桌面语音助手，说话简短自然口语化，每次不超过三句话。
# 全双工语音会话（/ws/voice-duplex）引擎选择：配置 MINIMAX_API_KEY 即默认走
# realtime 引擎；置 1 强制回退 pipeline 引擎（FunASR/Whisper + LLM + TTS）
# MINIMAX_REALTIME_DUPLEX_DISABLED=0

# ---------- FunASR 自托管 ASR（中文识别优于 whisper，本地部署无 API 费用） ----------
# 启动 Python 服务：pip install -r server/scripts/funasr_requirements.txt
#                  python server/scripts/funasr_server.py  （首次会下载 ~1GB 模型）
# 留空则回退到 OpenAI Whisper
# FUNASR_BASE_URL=http://127.0.0.1:8001
# 可选：ASR 主模型（默认 paraformer-zh）
# FUNASR_MODEL=paraformer-zh
# 可选：VAD / 标点恢复模型（在 funasr_server.py 启动参数中传入）
# 默认语言（zh / en / ja 等）
# FUNASR_LANGUAGE=zh
# 请求超时（毫秒，默认 60000）
# FUNASR_TIMEOUT_MS=60000

# ---------- 联网搜索（国内源，已移除 Jina/DuckDuckGo/Google News/Exa） ----------
# 搜索：必应中国 RSS + 36氪/IT之家 RSS；读页：直连抓取
# 带发布时间的搜索结果超过该天数则剔除（默认 120）；查历史/百科类长句不受此限
# SEARCH_MAX_ITEM_AGE_DAYS=120

# 【推荐】稳定搜索 API（优先于爬网页，更接近扣子/Coze 的联网效果；不配置则自动走爬网页兜底）
# 提供方：tavily | serper | bing | jina（不设或设 none = 关闭 API 搜索）
# SEARCH_API_PROVIDER=tavily
# 通用 API Key（Tavily / Serper / Bing 用同一个 SEARCH_API_KEY）：
#   - Tavily:  https://tavily.com  → SEARCH_API_PROVIDER=tavily, SEARCH_API_KEY=tvly-...
#   - Serper:  https://serper.dev → SEARCH_API_PROVIDER=serper, SEARCH_API_KEY=...
#   - Bing:    https://portal.azure.com → SEARCH_API_PROVIDER=bing, SEARCH_API_KEY=..., BING_SEARCH_API_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
#   - Jina:    SEARCH_API_PROVIDER=jina（免费无需 key；可选 JINA_API_KEY），SEARCH_API_KEY 不填
#   - AnySearch: SEARCH_API_PROVIDER=anysearch（AI Agent 统一搜索基础设施，文本主力；
#     文档 https://www.anysearch.com/docs ，可用 ANYSEARCH_ENDPOINT 覆盖默认端点）
# SEARCH_API_KEY=
# JINA_API_KEY=
# BING_SEARCH_API_ENDPOINT=
# AnySearch 图片垂直（search_images）：/v1/search + tag 路由，tag 默认按能力拓扑
# （GET /v1/sub-domains?domain=image）每 10 分钟自发现，服务端开放后自动生效；
# 可显式指定（如 ANYSEARCH_IMAGE_TAG=image.search），=off 关闭探测恒走必应爬页兜底
# ANYSEARCH_IMAGE_TAG=

# 图片搜索（search_images）工具超时：内部「结果页抓取 ≤5s + 转存硬预算 6.5s」按 12s 设计，
# 独立于 search_web 的 6.5s 快档（曾共享 6.5s 导致慢源查询被外层击杀、图片全丢）
# TOOL_TIMEOUT_SEARCH_IMAGES_MS=12000

# 可选：上游命令路径（不填则使用系统 PATH）
# MCPORTER_BIN=mcporter
# GH_BIN=gh
# RDT_BIN=rdt
# YTDLP_BIN=yt-dlp

# 国内平台建议在 mcporter 中配置的 server alias：
# weibo / xiaohongshu(或 xhs) / wechat / douyin

# ---------- MCP 客户端（Model Context Protocol） ----------
# 通过 mcporter CLI 连接 MCP Server，动态发现并注册工具到主 Agent
# 配置方式一：环境变量（逗号分隔 server alias）
# MCP_SERVERS=weibo,xiaohongshu,wechat,douyin
# 配置方式二：JSON 配置文件（支持 description、enabled 等字段）
# MCP_SERVERS_CONFIG=data/mcp-servers.json
# mcporter 二进制路径（不填则使用系统 PATH 中的 mcporter）
# MCPORTER_BIN=mcporter

# ---------- 滴滴 MCP ----------
# 滴滴官方 MCP（网约车 + 滴图地图），server 别名 didi，配置在 data/mcp-servers.json
# key 从 https://mcp.didichuxing.com/ 控制台获取，经 URL query 传递（url 中用 ${DIDI_MCP_KEY} 展开）
# 当前配置指向生产端点 mcp-servers（会真实下单）；调试时把 url 中的 mcp-servers 改回 mcp-servers-sandbox 即返回 Mock 数据
# DIDI_MCP_KEY=

# ---------- 飞猪 FlyAI 旅行查询 ----------
# 飞猪官方 flyai CLI（酒店/机票等全品类实时查询，报价层自动调用 search-hotel/search-flight）
# 安装即自动挂载（无需 API key）：npm install -g @fly-ai/flyai-cli
# FLYAI_BIN=          # 可选：自定义 CLI 可执行文件路径（默认取 PATH 里的 flyai）
# FLYAI_API_KEY=      # 可选：flyai 平台 key（由 CLI 自行读取）

# ---------- 瑞幸咖啡点单 MCP ----------
# 瑞幸咖啡官方 MCP（查店/选品/下单/查单/取消），server 别名 luckin，配置在 data/mcp-servers.json
# Token 获取：登录 https://open.lkcoffee.com/mcp 复制 Token（登录态保留一个月）
# 会真实下单，支付由用户本人扫码完成
# LUCKIN_MCP_TOKEN=

# ---------- Agent World ----------
# 对外可访问的 Agent World 网页根地址（生成 playUrl / watchUrl 时使用）
# 主服务内嵌世界 API：http://127.0.0.1:3000  独立站 Web UI：http://127.0.0.1:3333
# AGENT_WORLD_PUBLIC_URL=http://127.0.0.1:3000
# AGENT_WORLD_STANDALONE_URL=http://127.0.0.1:3333

# 本地一键启动：npm run dev:all（根目录，同时开 server + agent-world:3333）

# 开发/联调：允许 Agent 快速注册（无 SHA-256 题）。生产环境勿设为 1。
# AGENT_WORLD_PLACEHOLDER_REGISTER=1

# 允许通过 HTTP 修改世界（购买等）；默认关闭，仅工具可写。
# ALLOW_WORLD_HTTP_MUTATIONS=1

# Agent 中继是否强制同配对码互通（默认关闭）。
# AGENT_RELAY_REQUIRE_PAIR=0

# 可选：世界状态落盘路径（默认进程 cwd 下 data/world-state.json）
# WORLD_STATE_FILE=

# 服务端口（默认 3000）
# PORT=3000

# Agent World 独立站监听端口（npm run dev 内嵌启动时固定 3333；勿与 PORT 共用）
# AGENT_WORLD_STANDALONE_PORT=3333

# ---------- Mem0 记忆图（agentic-memory，实体链接 + 跨主题联想） ----------
# AGENT_AGENTIC_MEMORY_ENABLED=true
# AGENT_AGENTIC_MEMORY_DIR=data/agentic_memory
# AGENT_AGENTIC_MEMORY_COLLECTION=agentic_memories
# AGENT_AGENTIC_MEMORY_TOP_K=8
# AGENT_AGENTIC_MEMORY_LLM_MODEL=gpt-4o-mini
# AGENT_AGENTIC_MEMORY_INSTRUCTIONS=
# AGENT_QDRANT_URL=
# AGENT_QDRANT_API_KEY=
# Embedding 端点（OpenAI 兼容 /v1/embeddings）。内置本地向量引擎（bge-small-zh-v1.5）
# 零配置即用；如需远端（如 bge-m3 提升质量）显式配置：
#   AGENT_EMBEDDING_BASE_URL=https://your-embedding-provider/v1
#   AGENT_EMBEDDING_API_KEY=sk-xxx
#   AGENT_EMBEDDING_MODEL=BAAI/bge-m3
# 也可用 OPENAI_EMBEDDINGS_URL=... 指定完整 /embeddings 地址；维度按模型自动推导，可 AGENT_EMBEDDING_DIMENSIONS=1024 覆盖。
# AGENT_EMBEDDING_MODEL=text-embedding-3-small
# AGENT_KV_SUMMARY_APPEND_MODE=minimal

# ---------- obs_recall 定向读取语义增强（默认关） ----------
# 开启后：大工具结果归档时批量嵌入结构节，obs_recall query 定向读取做词面+语义混合打分，
# 同义/口语 query（如「后悔了怎么办」→ 退款章节）命中率显著提升。需同时配置上面的 embedding 端点。
# AGENT_OBS_CONTENT_EMBEDDING=on

# ---------- TokenJuice（工具结果压缩） ----------
# AGENT_TOKENJUICE_ENABLED=true
# AGENT_TOKENJUICE_MAX_TOOL_CHARS=12000

# ---------- Tool Search（核心工具库 + 延迟目录，减少 tools schema 占用） ----------
# AGENT_TOOL_SEARCH_ENABLED=auto
# AGENT_TOOL_SEARCH_BRIDGE_MODE=merged
# AGENT_TOOL_SEARCH_DISCOVER_AUTO_SCHEMA=true
# AGENT_TOOL_SEARCH_THRESHOLD_PCT=10
# AGENT_TOOL_SEARCH_DEFAULT_LIMIT=5
# AGENT_TOOL_SEARCH_MAX_LIMIT=20
# AGENT_TOOL_SEARCH_CONTEXT_TOKENS=32000
#
# 独立部署的 tool-router FastAPI 微服务地址（HTTP REST 模式）。
# 配置后工具检索优先走 HTTP 调用该服务；未配置或服务不可用自动回退 stdio bridge_worker。
# 启动方式:
#   - 随 npm 启动自动异步并行拉起（TOOL_ROUTER_HTTP_URL 配置后自动生效；
#     端口已被占用时不重复启动；TOOL_ROUTER_AUTO_START=0 可关闭自动拉起）
#   - 或手动: tool-router\start-tool-router.ps1
# TOOL_ROUTER_HTTP_URL=http://127.0.0.1:8787
# TOOL_ROUTER_AUTO_START=1

# UAP 慢变量注入 system；默认仅注入 persona/values/abilities/memory_summary
# AGENT_PROMPT_MEMORY_KEYS=off
# AGENT_PROMPT_MEMORY_KEYS=persona,values,abilities,memory_summary
# AGENT_PROMPT_MEMORY_SUMMARY_MAX_CHARS=1000
# AGENT_PROMPT_MEMORY_SUMMARY_MAX_LINES=6
# AGENT_SUBAGENT_MEMORY_SUMMARY_MAX_LINES=4
# AGENT_SUBAGENT_MEMORY_SUMMARY_MAX_CHARS=600

# Agent 能力摘要注入 system（默认关闭；按需调用 agent.query_capabilities）
# AGENT_PROMPT_AGENT_CAPS=1
# 世界能力摘要注入 system（默认关闭；按需调用 agent.query_capabilities(domain='world')）
# AGENT_PROMPT_WORLD_CAPS=1

# 长期记忆检索超时（毫秒，超时则跳过记忆块继续回复，默认 400）
# AGENT_NARRATIVE_RECALL_TIMEOUT_MS=400

# ---------- 用户画像与情感语气适配（USER_PROFILE.md） ----------
# AGENT_USER_PERSONALIZATION_ENABLED=1
# AGENT_USER_PROFILE_DIR=data/user_profiles
# AGENT_USER_PROFILE_PROMPT_MAX_CHARS=3500
# AGENT_USER_PROFILE_LLM_EVERY_N=8

# ---------- 短期对话线程落盘（重启后恢复最近 N 条消息，默认开启） ----------
# AGENT_CHAT_THREAD_PERSIST=1
# AGENT_CHAT_THREAD_PERSIST_MAX_MESSAGES=16
# AGENT_CHAT_THREAD_PERSIST_FILE=data/chat-threads.json

# ---------- 短期记忆增强（WAL + 当日 digest + 高信号 fast-path，默认 enhanced） ----------
# 短期记忆 openLoops/agentCommitments 挂起栈条目存活时长（毫秒，默认 6h，0=关闭清理）。
# 此前只进不出（闲聊轮永不触发 complete），陈年任务/承诺被周期性注入每轮 prompt（串台燃料）。
# AGENT_STM_LOOP_TTL_MS=21600000
# AGENT_SHORT_TERM_MEMORY=enhanced
# AGENT_TURN_WAL_ENABLED=1
# AGENT_TURN_WAL_DIR=data/turn-wal
# AGENT_DAILY_DIGEST_ENABLED=1
# AGENT_DAILY_DIGEST_FILE=data/daily-digests.json

# ---------- Memory Tree（权重迭代 · 事件淡化 · 用户了解度） ----------
# AGENT_MEMORY_TREE_ENABLED=true
# AGENT_MEMORY_FORGET_THRESHOLD=0.12
# AGENT_MEMORY_COGNITION_MIN_WEIGHT=0.35
# AGENT_MEMORY_HIGH_SIGNAL_BOOST=0.25
# AGENT_MEMORY_COGNITION_LLM=1
# AGENT_MEMORY_COGNITION_SYNC_PROFILE=1
# AGENT_DAILY_DIGEST_MAX_CHARS=1000
# AGENT_DAILY_DIGEST_PROMPT_MAX_CHARS=2500
# AGENT_DAILY_DIGEST_TIMEZONE=Asia/Shanghai
# AGENT_DEFER_TURN_ARCHIVE=1

# ---------- 前后台架构（前台对话面 / 后台任务面） ----------
# 前台默认回归原生 function calling：task.dispatch + search_web 两个工具常驻可见，
# 派发/查证走 API 结构化 tool_calls 通道（模型训练对齐保证格式）。
# AGENT_FOREGROUND_TAG_PROTOCOL=1 可回退已退役的 [dispatch:...] 文本标签协议
# （前台零工具 + 回复正文内嵌标签；模型不写标签即静默零工具，勿在生产使用）。
# AGENT_FOREGROUND_TAG_PROTOCOL=0

# ---------- 前后台架构（前台对话面 / 后台任务面） ----------
# 前台自决模式（默认开启）：前台模型带 task.dispatch + search_web 两个原生工具
# （function calling），要办事/查证在同一轮直接发起结构化工具调用；后台完成后
# 结果以独立消息回灌。AGENT_FOREGROUND_DISPATCH=0 回退独立路由 LLM 判定（遗留）。
# 文本标签协议（[dispatch:...]）已退役：其失败模式是"模型不写标签 = 静默零工具"，
# 设 1 仅作灰度回退。
# AGENT_FOREGROUND_TAG_PROTOCOL=0

# 任务面状态 WS 广播（2026-09-08 对话面任务回执）：TaskHub 生命周期变更以
# chat.task_update 推给客户端，对话流内渲染轻量任务回执（派发/进度/终态原地
# 更新，用户可继续聊天不被打断；chat.task_cancel 提供逐任务取消入口）。
# 设 0 整体回退：客户端收不到事件即不渲染回执，任务结果仍走 chat.assistant_done。
# AGENT_TASK_PLANE_WS_EVENTS_ENABLED=1

# ---------- 计划-执行循环（Plan-Execute Loop） ----------
# AGENT_PLAN_EXECUTE_LOOP=1 — 启用复杂任务的"计划→执行"流程（已移除自检环节，减少 50%+ LLM 调用）
# AGENT_PE_VERBOSE_STREAM=1 — 将阶段标题写入用户可见流

# 真实资金钱包默认币种与初始余额（与 Agent World 点数分离）
# REAL_FUNDS_DEFAULT_CURRENCY=CNY
# REAL_FUNDS_INITIAL_BALANCE=1000

# ---------- 支付通道（微信支付 + 支付宝）----------
# 模式：mock（默认，无需真实商户号即可测试）/ live（接入真实支付通道）
# WECHAT_PAY_MODE=mock
# ALIPAY_MODE=mock

# 微信支付 V3 API 配置（WECHAT_PAY_MODE=live 时必填）
# 申请入口：https://pay.weixin.qq.com → 接入微信支付 → API V3
# WECHAT_PAY_APP_ID=wxXXXXXXXXXXXXXXXX
# WECHAT_PAY_MCH_ID=1234567890
# WECHAT_PAY_API_KEY=your-api-v3-key
# WECHAT_PAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# WECHAT_PAY_CERT_SERIAL_NO=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 支付宝开放平台配置（ALIPAY_MODE=live 时必填）
# 申请入口：https://open.alipay.com → 开发者中心 → 网页&移动应用
# ALIPAY_APP_ID=2021001XXXXXXXXX
# ALIPAY_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# 支付宝网关（默认正式环境，沙箱环境用 https://openapi-sandbox.dl.alipaydev.com/gateway.do）
# ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

# 支付异步通知基础 URL（外网可访问的服务器地址，live 模式下用于接收支付结果回调）
# PAYMENT_NOTIFY_BASE_URL=https://your-domain.com

# ---------- 支付护栏（payment.create_order 通用网关的硬性边界，默认开启） ----------
# 差旅订票链路（支付宝 AI 支付）另有独立限额 BOOKING_MAX_AMOUNT_CNY / BOOKING_DAILY_BUDGET_CNY，
# 两层护栏互不替代。护栏设为 0 表示该项不限。
# 单笔上限（元）
# PAYMENT_MAX_SINGLE_CNY=1000
# 当日累计上限（元，按下单时间汇总，含未支付）
# PAYMENT_DAILY_BUDGET_CNY=3000
# 允许代付的业务类别（逗号分隔；* = 全部；未列出的类别 Agent 必须先向用户确认）
# PAYMENT_ALLOWED_CATEGORIES=*

# ---------- 能力配置来源（渐进式解锁；内测期默认 byok） ----------
# byok = 用户自备各服务 key（当前形态）；platform = 平台统一供 key（统一服务付费，
# 客户端能力卡片自动切换为"已包含"文案，无需发版）
# CAPABILITY_CONFIG_MODE=byok

# ---------- 美团 AI Hub Skill（跑腿购买能力）----------
# 在 https://developer.meituan.com/zh/v2/dev/aiHub 注册个人开发者后获取 Token
# MEITUAN_AI_HUB_TOKEN=your-access-token
# 默认 Skill ID 19 = 美团跑腿
# MEITUAN_AI_HUB_SKILL_ID=19
# API 基础地址（如需自定义）
# MEITUAN_AI_HUB_API_BASE=https://developer.meituan.com/api/v2/ai-hub

# ---------- 桌面桥接（Agent ↔ 本机 PC 截屏/键鼠） ----------
# DESKTOP_BRIDGE_ENABLED=1
# Windows Flutter 桌面端会在同 userId 下自动注册桥接（无需 Python 脚本）；与 Python 桥勿同时绑定同一 userId。
# 随 server 启动自动 spawn Python 桥接（Flutter 单机使用时建议 DESKTOP_BRIDGE_AUTO_START=0）
# DESKTOP_BRIDGE_AUTO_START=1
# 桥接 userId，须与客户端 USER_ID 或 sessionId 一致
# DESKTOP_BRIDGE_USER_ID=session-mvp-001
# DESKTOP_BRIDGE_WS_URL=ws://127.0.0.1:3000/ws
# Python 与 desktop-visual 目录（可选）
# DESKTOP_VISUAL_PYTHON=python
# DESKTOP_VISUAL_ROOT=../desktop-visual
# 服务端本机截屏/键鼠（不经过 PC 桥接时）
# DESKTOP_VISUAL_ENABLED=1

# ---------- 桌面 shell 工具（Agent 通过白名单调用 cmd / powershell / bash） ----------
# 启用 desktop.run_shell 工具。强制要求 DESKTOP_BRIDGE_TOKEN（≥8 字符）做鉴权。
# 关闭时工具仍会注册但调用直接拒，避免误开。
# DESKTOP_SHELL_ENABLED=1
# 关闭白名单模式：只走黑名单 + 正则短路（危险，等同于给 LLM 完整 shell）。
# DESKTOP_SHELL_ALLOWLIST=0 默认 1（白名单 + 黑名单双检）

# ---------- 桌面情境感知（SceneWatcher，默认关闭；情境监测涉及隐私须显式开启） ----------
# 开启后：检测到视频会议自动勿扰（结束后恢复）；前台长时间看 PDF/docx/txt 等文档
# 自动生成摘要+关键问题；停留商品页自动比价。检测零 token（窗口标题/进程/心跳），
# 摘要/比价每次触发仅一次 LLM 调用。依赖桌面桥接在线或本机 DESKTOP_VISUAL_ENABLED=1。
# DESKTOP_SCENE_WATCHER_ENABLED=1

# 日程任务持久化文件（默认 data/schedule-tasks.json）
# SCHEDULE_TASKS_FILE=

# ---------- 微信 Claw（OpenClaw openclaw-weixin 渠道） ----------
# 须在本机运行 OpenClaw Gateway，并安装 @tencent-weixin/openclaw-weixin 插件
# WECHAT_CLAW_ENABLED=1
# OPENCLAW_GATEWAY_WS_URL=ws://127.0.0.1:18789
# 本地开发（npm run dev:all 会自动起 Gateway）：OPENCLAW_GATEWAY_AUTH=none，token 可留空
# OPENCLAW_GATEWAY_AUTH=none
# OPENCLAW_GATEWAY_TOKEN=your-gateway-token
# 或使用密码：OPENCLAW_GATEWAY_PASSWORD=
# 首次：npm run setup:openclaw
# OPENCLAW_WEIXIN_CHANNEL=openclaw-weixin
# 绑定记录落盘（默认 data/wechat-claw-bindings.json）
# WECHAT_CLAW_BINDING_FILE=
# 可选：固定 OpenClaw accountId；不设则使用 Gateway 默认账号
# WECHAT_CLAW_ACCOUNT_ID=
# WECHAT_CLAW_ACCOUNT_ID_PREFIX=private-agent-

# ---------- 微信消息桥（OpenClaw 只收发，推理走主服务 AgentCore）----------
# 启用后请执行：npm run setup:openclaw-wechat-bridge
# WECHAT_CLAW_BRIDGE_ENABLED=1
# 与 Flutter USER_ID / DESKTOP_BRIDGE_USER_ID 对齐
# WECHAT_CLAW_BRIDGE_ACTOR_ID=session-mvp-001
# 非本机访问时必填（OpenClaw 插件请求鉴权）
# WECHAT_CLAW_BRIDGE_TOKEN=

# ---------- 通用消息桥（QQ / 飞书 / 微信 / 自定义） ----------
# 统一入站开关；启用后可通过 /integrations/messages/inbound 写入消息聚合中心
# MESSAGE_BRIDGE_ENABLED=1
# 可选：统一桥接请求鉴权
# MESSAGE_BRIDGE_TOKEN=
# 未提供 userId/sessionId 时使用的默认 actor
# MESSAGE_BRIDGE_DEFAULT_ACTOR_ID=session-mvp-001
# 渠道会话隔离（默认开启）：入站消息无显式 userId/sessionId 绑定时，按来源平台派生
# `actorId@平台` 独立会话，不再共用主线程（跨渠道串台的构造性隔离）。
# AGENT_CHANNEL_SESSION_ISOLATION=0 可回退旧行为。

# ---------- 聚合消息发送桥配置 ----------
# 当 Agent 回复聚合会话时，会按平台调用对应桥接器 URL 进行真实发送
# 这些 URL 建议指向你自己的 QQ / 飞书 / 微信机器人中间层

# 微信发送桥
# WECHAT_BRIDGE_SEND_URL=http://127.0.0.1:3101/send
# WECHAT_BRIDGE_SEND_TOKEN=

# QQ 发送桥
# QQ_BRIDGE_SEND_URL=http://127.0.0.1:3102/send
# QQ_BRIDGE_SEND_TOKEN=

# 飞书发送桥
# FEISHU_BRIDGE_SEND_URL=http://127.0.0.1:3103/send
# FEISHU_BRIDGE_SEND_TOKEN=
# WECHAT_CLAW_BRIDGE_TOKEN=
# 已废弃：沙箱模式已移除，Agent 始终以 full 运行；字段保留仅为协议兼容
# WECHAT_CLAW_BRIDGE_AGENT_ACCESS_MODE=full

# ---------- Webhook 事件驱动（Agent 生命周期 / 价格 / 数据事件对外 HTTP 推送） ----------
# 启用 Webhook（默认关闭）
# WEBHOOK_ENABLED=true
# 默认端点 URL 列表（逗号分隔，服务启动时自动注册）
# WEBHOOK_URLS=https://your-server.com/api/webhook/receive
# HMAC-SHA256 签名密钥（不填则不签名；接收方用同一密钥验证 X-Webhook-Signature-256）
# 同时也是 /api/webhooks/inbound/* 端点的鉴权密钥（外部数据源推送价格/数据时使用）
# WEBHOOK_SECRET=your-secret-key
# 单次请求超时毫秒（默认 10000）
# WEBHOOK_TIMEOUT_MS=10000
# 失败重试次数（默认 2）
# WEBHOOK_RETRY_COUNT=2
# 重试间隔基数 ms，指数退避（默认 1000）
# WEBHOOK_RETRY_BASE_MS=1000
# 并发调度上限（默认 5）
# WEBHOOK_MAX_CONCURRENT=5
# 事件历史最大保留条数（默认 200）
# WEBHOOK_MAX_HISTORY=200

# ---------- 外部数据源接入（价格 / 监控 / IoT） ----------
# 外部数据源通过 POST /api/webhooks/inbound/market 主动推送数据
# 事件类型：market.position_snapshot / market.anomaly / data.threshold_breach / data.source_heartbeat
# 鉴权：在请求体中传入 secret 字段，值必须与 WEBHOOK_SECRET 一致
# 请求体示例：
# {
#   "actorId": "user-001",
#   "eventType": "market.anomaly",
#   "secret": "your-secret-key",
#   "payload": {
#     "symbol": "AAPL",
#     "anomalyType": "price_drop",
#     "summary": "AAPL 暴跌 8.5%",
#     "priceChangePct": -8.5,
#     "volumeRatio": 3.2,
#     "confidence": 0.92
#   }
# }

# ---------- 实验性子系统开关（偏离 C 端私人管家主链路，默认全部 0=关闭） ----------
# 统一读取规则：设 1/true/yes/on 开启；未设置或 0/false/off/no 一律关闭。
# 开启后各子系统行为与改造前完全一致（零行为差异）；关闭时启动日志会输出
# 对应的 "[skip] xxx disabled by ENV" 一行提示。

# EvolutionCortex 子系统（自学习 / 技能生成 / 晋升管道 / 知识沉淀）总开关。
# 默认 0=关闭：整个 EvolutionCortex 块跳过装配。设 1 开启。
# 开启后由 用户 / Agent 经 brain.propose_capability 显式提建、brain.execute_proposal
# 显式执行（不再有后台自动驱动的进化循环 / 技术扫描 / benchmark）。
# 兼容旧变量（任一设 1 等效开启，无需改动既有配置）：
#   BRAIN_SELF_DRIVEN_EVOLUTION_ENABLED=1
#   AGENT_EVOLUTION_LOOP_ENABLED=1
# BRAIN_EVOLUTION_ENABLED=0

# Agent World 社交经济域开关（world-free-market / world-music / world-social /
# a2a-outsourcing / community-skill-store）。默认 0=关闭：跳过社交路由 mount、
# WS world.social.* 事件处理、LLM 社交经济工具注入（仅保留 world.open_registry.* /
# world.room.* 的 identity/pairing/registration 最小集）与 A2A escrow 启动对账。
# 设 1 开启恢复现状。
# AGENT_WORLD_SOCIAL_ENABLED=0

# ---------- 位置能力（方案 A-D）：追踪类默认关闭，历史/常去地点默认本地开启 ----------
# 位置追踪模式：
#   ondemand    按需（默认）：对话 prompt 与位置类工具需要位置时向客户端按需拉 GPS（带冷却，零 LLM）
#   continuous  持续：客户端按间隔定时上报，服务端写位置历史（本地 SQLite）+ 地理围栏判定 + 常去地点挖掘
# LOCATION_TRACKING_MODE=ondemand
# 持续模式上报间隔（秒），缺省 300（5 分钟），夹紧 30..3600
# LOCATION_REPORT_INTERVAL_SEC=300
# 位置历史存储开关：显式 1/0 优先；未设置时默认开启（本地 SQLite 不上云）——
# 对话 prompt 的【常去地点】块（DBSCAN 纯算法挖掘）依赖历史样本
# LOCATION_HISTORY_ENABLED=
# 历史轨迹保留天数（缺省 7），超期惰性清理；用户可经 Agent 一键清除
# LOCATION_HISTORY_RETENTION_DAYS=7
# 位置 SQLite 库路径（缺省 data/location/location.db，纯本地不上云）
# AGENT_LOCATION_DB=
# DBSCAN 常去地点聚类：半径（米，缺省 150）与成簇最小样本数（缺省 20）
# LOCATION_DBSCAN_EPS_METERS=150
# LOCATION_DBSCAN_MIN_POINTS=20
# 地理围栏与到达触发的主动频控（可覆盖）：
# PROACTIVITY_COOLDOWN_LOCATION_ARRIVAL=21600000
# PROACTIVITY_COOLDOWN_GEOFENCE_EVENT=1800000

# ---------- 主动性（状态板 + 映射规则，2026-09-24 架构定稿） ----------
# 主动性决策已全面确定性化：传感器 → WorldBoard 状态板（分层整理）→ 映射规则表
# （mapping-rules.ts，一条规则一个场景）→ 仲裁 → 管道投递。全链零 LLM：
# LLM 通用评估路径（InitiativeEngine/感知流/去抖评估/L0 分诊）已于 2026-09-24 整体拆除
# （token 账本实测该通道 15-50 万 token/天、投递为零）。旧的 PROACTIVITY_LLM_INITIATIVE /
# PROACTIVITY_TICK_MS / PROACTIVITY_INITIATIVE_DEBOUNCE_MS / PROACTIVITY_MAX_EVALS_PER_DAY
# 随之失效。规则场景清单见 server/src/proactivity/mapping-rules.ts（加场景=加一行）。
# 话术模型路由仍有效（仅临会提醒/消息爆发两类内容型事件投递时做一次话术润色）
# PROACTIVITY_MODEL=
# 润色层模型钉位（推荐显式配置：主聊天模型将来升级时，润色不跟着变贵；
# 优先级 PROACTIVITY_PHRASE_MODEL > PROACTIVITY_MODEL > provider 默认）
# PROACTIVITY_PHRASE_MODEL=
# 润色的重要性门槛（默认 high：低于此档的提醒直接走零 LLM 模板，不花润色调用）
# PROACTIVITY_PHRASE_MIN_IMPORTANCE=high
# 每日润色调用熔断（默认 30）
# PROACTIVITY_MAX_PHRASE_PER_DAY=30

# ---------- 计划推进（goal plan）成本治理（2026-10-01） ----------
# 每日 goal 步骤派发上限（默认 24：约两个满配 12 步计划；超出后步骤停在待办，
# 计划如实标注「预算超限」等用户指示，不静默假装推进）
# PROACTIVITY_GOAL_DAILY_BUDGET=24
# 轻步骤车道（默认开）：总结/整理/回顾类步骤按小预算快档派发省 token；=0 关闭
# GOAL_PLAN_LIGHT_LANE=1

# ---------- 兴趣监控语义匹配（2026-10-01） ----------
# 复用本地 bge-small-zh embedding 做兴趣×热搜语义匹配（默认开；=0 退回纯字面包含）
# INTEREST_SEMANTIC_MATCH=1
# 语义命中余弦阈值（默认 0.45：实测 bge-small-zh 无关负例 0.27-0.32 /
# 换说法正例 0.49-0.66，0.45 居分界空带）
# INTEREST_SEMANTIC_THRESHOLD=0.45

# ---------- 任务面工具暴露（2026-09-23 token 优化） ----------
# task 车道暴露模式：缺省 router-first——可见集只有 tool_discover/tool_call 桥，
# 全量工具进 BM25 延迟目录按需召回（省 ~5k tok/轮）；回滚设 core 恢复静态
# 36 工具全量 schema 注入。chat 车道不受影响。
# AGENT_TASK_LANE=router

# ---------- 承诺草稿板（commitment board） ----------
# 板子总开关 / 扫描间隔 / 自动提取开关（缺省全开）
# AGENT_COMMITMENT_BOARD_ENABLED=1
# AGENT_COMMITMENT_SCAN_INTERVAL_MIN=5
# AGENT_COMMITMENT_AUTO_EXTRACT_ENABLED=1
# 承诺提取范围（P0-2 与记忆路由解耦）：
#   high = 仅高信号写入抽取（旧行为，灰度回退档）
#   all  = 低信号也抽取（缺省）——"明天发你"这类 decay 口语承诺同样捕获
# AGENT_COMMITMENT_EXTRACT_SCOPE=all

# ---------- 用户理解档案（user understanding store） ----------
# agent 对用户理解的结构化沉淀：topic + 理解句（含语气/性质判断，如粉丝式
# 称呼、玩笑、更正）+ 演变历史。同话题新理解生效即旧理解入历史（不删除）；
# prompt 注入【我对用户的理解】块，问句命中话题词时直接基于当前理解回答。
# AGENT_USER_UNDERSTANDING_ENABLED=1

# ---------- 会话线程：滑动窗口 + 增量摘要 ----------
# 对话层裁剪策略：最近 RECENT_WINDOW_MESSAGES(12) 条原样保留；窗口外内容先进
# [unsummarized] 待归纳区（原文占位、始终在线程内可见），再由 LLM 增量摘要逐批
# 吸收进摘要区——归纳成功前不丢内容。摘要行带绝对时间标签（YYYY/MM/DD 周X HH:MM），
# 跨天不产生错误的相对时间词。
# LLM 滚动摘要区预算（行数/单行字符；摘要器提示词同预算）
# SESSION_SUMMARY_MAX_LINES=30
# SESSION_SUMMARY_MAX_CHARS=2400
# 待归纳区预算（超限保留最旧行；被淘汰行的全文仍在 turn WAL 可检索兜底）
# SESSION_PENDING_MAX_LINES=24
# SESSION_PENDING_MAX_CHARS=2400
# 滚动摘要用的模型（缺省跟随主对话 provider）
# AGENT_RECAP_SUMMARIZE_MODEL=
# AGENT_RECAP_SUMMARY_MAX_LINES=30
# AGENT_RECAP_SUMMARY_MAX_LINE_CHARS=160

# ---------- 预订闭环（travel 域：机票/火车票/酒店代办 + 支付宝 AI 支付） ----------
# 支付走支付宝 AI 支付通道（用户本人钱包真实扣款），需先配置 ALIPAY 相关项
# （见上方「支付通道」；AI 支付依赖 server/alipay-bot-cli/，无需商户号）。
# 预订层限额沿用 BOOKING_MAX_AMOUNT_CNY / BOOKING_DAILY_BUDGET_CNY。
# 下单时若带商家收银台链接（cashierUrl）可直接发起支付；
# 也可用 alipay.proxy-trade 从商家下单接口提取收银台链接。

# ---------- 到站管家（接站 / 接机 / 到站打车） ----------
# 航旅纵横开放平台（航班实时动态；https://www.variflight.com）
# VARIFLIGHT_APP_ID=
# VARIFLIGHT_APP_SECRET=
# VARIFLIGHT_API_BASE=https://gateway.variflight.com
# 聚合数据车次时刻表（高铁/火车时刻核对；https://www.juhe.cn/docs/api/id/40）
# JUHE_TRAIN_KEY=
# JUHE_TRAIN_API_BASE=https://apis.juhe.cn
# 说明：两者都未配置时按票面时间监控 + 设备定位兜底（到达车站/机场附近视为已到达）。
# 接站通知通道：短信复用 ALIYUN_SMS_*（见 email-sms-service），微信/QQ/飞书复用
# 上方 *_BRIDGE_SEND_URL 发送桥。

# ---------- 习惯学习 → 自动执行闭环 ----------
# 规则/观察落盘（默认 data/habit-loop/）
# HABIT_AUTO_MIN_CONFIDENCE=0.7
# 说明：auto 授权只在置信度 ≥ 门槛时生效；连续自动失败 2 次自动降回「每次确认」。
# 安静时段由每条规则自带（quietHours），命中时只提案不执行。

# ---------- 全双工实时语音（WS /ws/voice-duplex） ----------
# 复用 FunASR（流式 ASR）+ MiniMax/OpenAI TTS + OpenAI LLM（chatStream），
# 上方对应密钥配置好即可。会话级 system prompt 可选覆盖：
# VOICE_DUPLEX_SYSTEM_PROMPT=

# ---------- 记忆召回：FTS 关键词第三路 + 精排（2026-09-07）----------
# FTS：SQLite FTS5 全文索引（中文 bigram），作为 bridge 融合召回的第三路 rank
# 参与 RRF——专名/技术栈等低语义密度 query 上补向量短板。默认开，置 0 关闭；
# 存量记忆启动 30s 后自动回填索引（AGENT_MEMORY_FTS_BACKFILL=0 跳过）。
# AGENT_MEMORY_FTS_ENABLED=1
# AGENT_MEMORY_FTS_TOP_K=12
#
# 精排：对融合后的召回候选做 (query, memory) 联合打分再注入，默认 off。
#   llm = 复用对话 LLM listwise 打分（零基建，~300-800ms，阈值闸丢弃无关条目）
#   api = 专用 rerank 端点（Jina/Cohere 风格 POST {model, query, documents}）
# 超时/失败自动透传原序，不影响召回可用性。
# AGENT_MEMORY_RERANKER=off
# AGENT_MEMORY_RERANKER_ENDPOINT=https://your-rerank-provider/v1/rerank
# AGENT_MEMORY_RERANKER_MODEL=bge-reranker-v2-m3
# AGENT_MEMORY_RERANKER_API_KEY=
# AGENT_MEMORY_RERANKER_TIMEOUT_MS=800
# AGENT_MEMORY_RERANKER_CANDIDATES=24
# AGENT_MEMORY_RERANKER_MIN_SCORE=0.15

# ---------- 后台并行与 token 优化（2026-09-08）----------
# 后台任务面全局并发上限：多个后台任务天然并行，此闸防止同时执行数失控打满
# LLM provider 限流。桌面/浏览器等具身域工具另有分域单飞闸（同域全局=1），不在此配。
# AGENT_BG_TASK_MAX_PARALLEL=4
#
# Worker 线程池并行度（code.run / image.generate），此前每类型单 Worker 串行排队。
# 与 MAX_CONCURRENT_CODE_RUN / MAX_CONCURRENT_IMAGE_GEN 信号量对齐。
# WORKER_POOL_SIZE_CODE=2
# WORKER_POOL_SIZE_IMAGE=2
#
# 任务面（task_plane_*）工具结果预算缩放（0-1]：后台任务产物是总结性回复，
# 检索结果按比例收缩（search_web 7000→4200 等），前台对话面不受影响。
# AGENT_TASK_TOOL_BUDGET_SCALE=0.6

# ---------- 电话代办（phone_call.*：agent 代拨真实电话，2026-09-18）----------
# agent 向第三方真人发起真实 PSTN 外呼（预约/确认/回电）。P0 为脚本托管：
# 拨前确认卡（chat 内点击确认，LLM 不可绕过）→ 经手机桥拨出（手机端二次全屏确认，
# 通话由用户亲自进行）→ 挂断后结构化结果回填（收件箱必达回执）。
# 与虚拟电话（agent.phone.* 站内互拨）是两个并行体系，互不复用（docs/phone-call-architecture.md）。
# 总开关：默认 false——工具对 LLM 完全不可见。
# PHONE_CALL_ENABLED=false
#
# 同一被叫号码 24 小时内最多拨出次数（防打扰硬上限）
# PHONE_CALL_PER_NUMBER_24H_LIMIT=2
#
# 单用户每自然日最多拨出次数
# PHONE_CALL_DAILY_LIMIT=20
#
# 静默时段（HH:mm-HH:mm，可跨午夜），时段内禁止外呼
# PHONE_CALL_QUIET_HOURS=22:00-08:00
#
# 等待用户确认的 TTL（毫秒），超时未确认自动作废
# PHONE_CALL_CONFIRM_TTL_MS=600000
#
# 手机桥 dial 调用超时（毫秒；含手机端全屏二次确认的等待窗口）
# PHONE_CALL_DIAL_TIMEOUT_MS=45000
#
# 默认单通时长上限（秒）；prepare 输入只能缩小不能放大
# PHONE_CALL_MAX_DURATION_SEC=300

# ---------- critical 升级链离线必达（2026-09-18 设备分级触达）----------
# 电脑端+移动端全部离线时，提醒升级链直达「系统级推送 → 短信 → 微信」离线通道。
# 短信末级兜底的收件人（私人管家单主人场景；需同时配齐下方 ALIYUN_SMS_* 凭证）。
# 未配置号码时短信环节如实跳过，链路继续落微信/站内信。
# REMINDER_SMS_TO=13800000000

# ---------- 移动端离线系统级推送（App 被杀后仍可触达）----------
# Provider 可插拔，按配置自动启用；三者配其一无须客户端改造的推荐顺序：
#   1) webhook + ntfy（零 SDK：手机装 ntfy App → 订阅 topic → URL 填 https://ntfy.sh/<你的topic>）
#   2) jpush（国内聚合厂商通道；需在极光后台建应用，客户端 MobilePushPlugin 接 SDK 后上报 token）
#   3) bark（iOS 个人推送；BARK_URL 填 Bark App 的设备端点）
# 极光推送（REST API v3）
# JPUSH_APP_KEY=
# JPUSH_MASTER_SECRET=
# JPUSH_APNS_PRODUCTION=0
# Bark（iOS）
# BARK_URL=
# 通用 HTTP 出站（ntfy/Server酱/WxPusher/自建网关）
# MOBILE_PUSH_WEBHOOK_URL=
# MOBILE_PUSH_WEBHOOK_TOKEN=

# ---------- 出站邮件（email.send 工具；SMTP 真实发信）----------
# host/user/pass 齐备即启用；from 缺省取 user。
# OUTBOUND_SMTP_HOST=smtp.qq.com
# OUTBOUND_SMTP_PORT=465
# OUTBOUND_SMTP_SECURE=true
# OUTBOUND_SMTP_USER=
# OUTBOUND_SMTP_PASS=
# OUTBOUND_SMTP_FROM=

# ---------- Agent 站内邮箱（入站 webhook：外部邮件网关投递到 Agent 域名）----------
# 邮件网关（Mailgun/Cloudflare Email Routing/自建 MTA）把投递 POST 到
# /accounts/register/email/inbound（X-Agent-Mail-Secret 鉴权）。财务账单邮件自动
# 记账（/finance/ingest/email/inbound）同样依赖这两个配置 + 用户绑定账单邮箱。
# AGENT_MAIL_DOMAIN=agents.privateai.local
# AGENT_MAIL_INBOUND_SECRET=

# ---------- 阿里云短信（sms.send 工具 + critical 提醒短信兜底）----------
# 四项齐备即启用（dysmsapi RPC 签名直调）。模板需含 ${content} 占位。
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=

# ---------- 用户邮箱盯梢（IMAP 轮询：Agent 帮用户检测新邮件）----------
# 开启后服务端定时拉取收件箱，新邮件做重要性分级（VIP/关键词规则），
# 重要邮件经主动性管道主动提醒，并同时进消息中心（platform=email）。
# MAIL_WATCH_ENABLED=0
# MAIL_WATCH_HOST=imap.qq.com
# MAIL_WATCH_PORT=993
# MAIL_WATCH_USER=
# MAIL_WATCH_PASS=
# MAIL_WATCH_MAILBOX=INBOX
# MAIL_WATCH_POLL_SEC=120
# 改为 1 会把处理过的邮件标为已读（默认 0：只记录已处理 UID，不动邮箱状态）
# MAIL_WATCH_MARK_SEEN=0
# 消息归属用户（缺省 MESSAGE_BRIDGE_DEFAULT_ACTOR_ID，再兜底 default_user）
# MAIL_WATCH_ACTOR_ID=
# 逗号分隔的 VIP 发件人白名单（命中即 critical，且不受营销过滤影响）
# MAIL_WATCH_VIP_SENDERS=boss@company.com,family@qq.com
# 营销/广告邮件自动过滤（默认 1）：识别 List-Unsubscribe 头/营销主题词/退订尾巴，
# 命中的邮件不推送提醒、也不进消息中心；置 0 关闭（误杀兜底阀门）
# MAIL_WATCH_FILTER_PROMO=1
# 开启盯梢后自动附带（无独立开关）：票务/日历邮件（12306 购票/改签/退票、航司/OTA
# 出票、酒店确认、.ics 日历附件）会静默落成日程（进「今日安排」，可随时让 Agent 删），
# 一轮多封只发一条汇总提醒；宁漏不误报，解析不了就跳过。

# ---------- ICS 日历订阅轮询（日程零手工：外部日历自动导入，2026-09-24）----------
# 配入 .ics 订阅链接（公司/学校/健身房日历导出 URL），服务定时拉取 diff，
# 未来的日历事件自动落成日程（进「今日安排」/冲突检测/到点提醒）；
# 源里改期/取消会反向同步到日程，变更合并成一条汇总提醒，不逐条轰炸。
# ICS_SUB_ENABLED=0
# 逗号分隔的「名称=URL」或裸 URL（裸 URL 用域名当名称）
# ICS_SUB_URLS=工作日历=https://example.com/calendar/work.ics
# ICS_SUB_POLL_SEC=900
# ICS_SUB_LOOKAHEAD_DAYS=35
# ICS_SUB_ACTOR_ID=

# ---------- 财务账单后台自动拉取（支付宝 Cookie 代查，2026-09-18）----------
# 开启后每日定点用用户支付宝登录态自动拉交易明细（Playwright 无头浏览器，
# Cookie 须先经浏览器会话导入 siteId=alipay 并授权 agentAllowed——与购物域同一套双门禁）。
# 拉到的交易按确定性 id（alipay:<交易号>）与账本幂等去重，只入新增，绝不重复记账。
# 注意：微信支付无网页版钱包，无法后台代查——实时入账走微信桥「微信支付」服务通知，
# 历史账单仍需用户在微信内导出后粘贴（finance.import_transactions 自动识别）。
# FINANCE_BILL_AUTO_FETCH_ENABLED=0
# 调度二选一：
#   准实时轮询（每 N 分钟拉一次增量，下限 10 分钟——更高频对支付宝登录态风控不友好；
#   秒~分钟级的真·实时走账单邮件通道：MAIL_WATCH_* + 用户在支付宝/银行开启交易邮件提醒）
# FINANCE_BILL_AUTO_FETCH_INTERVAL_MIN=30
#   或 每日定点（INTERVAL_MIN=0 时生效，0-23 点，默认 21 点）
# FINANCE_BILL_AUTO_FETCH_HOUR=21
# 每次拉取窗口天数（覆盖跨天边界与失败补拉，默认 3）
# FINANCE_BILL_AUTO_FETCH_DAYS=3
# 目标用户（逗号分隔；缺省 MESSAGE_BRIDGE_DEFAULT_ACTOR_ID，再兜底 default_user）
# FINANCE_BILL_AUTO_FETCH_ACTORS=

# ---------- 支付/收款通知实时记账（钱迹模式，2026-09-18）----------
# 无需配置：手机 App 授予「通知使用权」后，支付宝 App 的支付/收款推送自动实时入账
# （零 LLM 确定性解析，宁可漏记不可错记；营销/积分类推送自动排除）。
# 微信侧无需新配置：通知监听捕捉的「微信支付」通知 + 微信桥服务通知双通道
# 已共用同一指纹去重，不会重复记账。漏记部分由 Cookie 轮询（3 天窗口）兜底对账。

# ---------- 女性关怀（period-care 生理周期 / safety-guard 安全守护，2026-09-19）----------
# 周期记录、情绪打卡、紧急联系人等敏感数据以 AES-256-GCM 加密落盘
# （data/period-care/ 与 data/safety-guard/，密文存储、本地不外发）。
# 密钥：优先 WELLNESS_DATA_SECRET；未配置时回退 BROWSER_SESSION_SECRET / SESSION_SECRET。
# 建议单独配置并妥善保管——密钥丢失或更换后历史数据将无法解密。
# WELLNESS_DATA_SECRET=
#
# 生理周期临近提醒（tier=must 直投，提前 N 天的本地提醒时刻经主动性管道推送）：
# 数据目录缺省 data/period-care/；一键清除走 period 域工具（purge 文件级删除）。
#
# 安全守护（safety.*）依赖说明：
#   - SOS 短信通知紧急联系人复用 ALIYUN_SMS_*（见下方阿里云短信段），未配置时
#     SOS 仍会获取定位并告警本机设备，但代发短信会如实失败并提示直接拨打 110/120
#   - 借口来电复用电话代办通道（PHONE_CALL_ENABLED=1 + 手机桥），走完整确认门；
#     注意 PHONE_CALL_QUIET_HOURS 静默时段会同时拦住借口来电
#   - SOS 定位为按需单次获取（LocationCoordinator ondemand），不开启持续追踪、不落位置历史

# ---------- 官方联盟 API 比价数据源（2026-09-24，官方优先 / Playwright 兜底）----------
# 配置了凭据的平台走联盟 API 直查（服务器侧、零用户 Cookie、个人开发者可申请），
# 未配置的平台自动回落 Playwright + 用户 Cookie 兜底，行为与旧版一致。
# 比价与降价监控的返回值会标注数据来源（official_api / browser）与抓取时效。
#
# 淘宝客（open.taobao.com → 媒体备案 → 淘宝客推广位拿 adzone_id）
# TAOBAO_TBK_APP_KEY=
# TAOBAO_TBK_APP_SECRET=
# TAOBAO_TBK_ADZONE_ID=
#
# 京东联盟（union.jd.com → 个人实名 → 媒体账号 → AppKey/Secret；代推广需授权）
# JD_UNION_APP_KEY=
# JD_UNION_APP_SECRET=
# JD_UNION_ACCESS_TOKEN=
#
# 多多进宝（open.pinduoduo.com → 个人应用 → 多多进宝；个人过审快、日配额 2000 次）
# PDD_DDK_CLIENT_ID=
# PDD_DDK_CLIENT_SECRET=
# PDD_DDK_ACCESS_TOKEN=
#
# 计划推进（goal.plan.*，对标 Muse 大目标模式）：
# GOAL_PLAN_AUTO_EXTERNAL=0
#   0（默认）= 外部副作用步骤（下单/发送/支付类）推进到门口先停下等用户确认
#   1        = 外部步骤也自动派发（不建议：信任优先）
#
# 管理后台网络层门禁（admin-console-gate.ts）
# ADMIN_CONSOLE_ALLOW_REMOTE=0
#   默认（留空/0）= /admin 页面与全部 /api/admin/* 仅本机回环可达（SSH 隧道访问），
#                 公网请求一律 404，密码只是第二道锁
#   1            = 显式放行公网访问（须自备反代/白名单等替代防护）
#
# LLM 日用量告警（llm-budget-guard）：阈值命中（80%/100% 各一次）发站内信
# 给该 actorId（管理员账号）；不配置则仅 console 告警。阈值本身见
# AGENT_LLM_BUDGET_SESSION_TOKENS / AGENT_LLM_BUDGET_DAILY_TOKENS。
# AGENT_LLM_BUDGET_ALERT_ACTOR=
