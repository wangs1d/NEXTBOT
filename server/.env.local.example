# 复制为 .env.local 并填入真实密钥（此文件可安全提交，不含密钥）
# Kimi / Moonshot OpenAI 兼容 API
#   国内控制台密钥 → https://api.moonshot.cn/v1（platform.moonshot.cn / Kimi 开放平台）
#   国际控制台密钥 → https://api.moonshot.ai/v1（platform.moonshot.ai）
EXTERNAL_MODEL_PROVIDER=moonshot-kimi
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2.5
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# 如改用 OpenAI，可启用显式 prefix cache key 复用固定 system/tools 前缀的 KV cache
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_PREFIX_CACHE_ENABLED=1
# OPENAI_PROMPT_CACHE_NAMESPACE=nextbot-system-prompt-v1
# OPENAI_PROMPT_CACHE_RETENTION=24h
# MOONSHOT_PREFIX_CACHE_ENABLED=1
# MOONSHOT_PROMPT_CACHE_NAMESPACE=nextbot-system-prompt-v1

# ---------- 微信 Claw（OpenClaw Gateway，复制到 .env.local）----------
# WECHAT_CLAW_ENABLED=1
# OPENCLAW_GATEWAY_WS_URL=ws://127.0.0.1:18789
# OPENCLAW_GATEWAY_AUTH=none
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_WEIXIN_CHANNEL=openclaw-weixin
# 消息桥（与 App 同一套 AgentCore / 记忆 / 工具）：
# WECHAT_CLAW_BRIDGE_ENABLED=1
# WECHAT_CLAW_BRIDGE_ACTOR_ID=session-mvp-001

# ---------- 支付通道 ----------
# WECHAT_PAY_MODE=mock
# ALIPAY_MODE=mock
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_API_KEY=
# WECHAT_PAY_PRIVATE_KEY=
# WECHAT_PAY_CERT_SERIAL_NO=
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# ---------- 美团 AI Hub Skill ----------
# 在 https://developer.meituan.com/zh/v2/dev/aiHub 注册个人开发者后获取
MEITUAN_AI_HUB_TOKEN=b6d340e64c11cd62cadb7605aad4b2c2383e96d3c5318f5111c15d2bf4bb4417
MEITUAN_AI_HUB_SKILL_ID=19

# ---------- 地图与旅行规划（未配置时行程规划降级到内置知识库）----------
# 高德 Web 服务 key（国内地理编码/POI/路线耗时；https://console.amap.com 应用管理）
AMAP_WEB_KEY=
# Foursquare Places API key（国际目的地 POI；https://developer.foursquare.com → New Project）
FSQ_API_KEY=
